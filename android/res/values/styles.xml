<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge-to-edge is configured in LumenActivity (bars transparent, insets reported to Rust). The window background only shows for the
         first frames, so it matches the app's light / dark chrome. -->
    <style name="LumenTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:colorBackground">@color/window_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>
</resources>
